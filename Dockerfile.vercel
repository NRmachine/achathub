FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --classmap-authoritative \
    --no-scripts

FROM php:8.4-cli-alpine

RUN apk add --no-cache libxml2 libpq libxml2-dev postgresql-dev \
    && docker-php-ext-install dom pdo_pgsql opcache \
    && apk del libxml2-dev postgresql-dev

RUN printf '%s\n' \
    'expose_php=Off' \
    'opcache.enable=1' \
    'opcache.enable_cli=1' \
    'opcache.validate_timestamps=0' \
    'opcache.memory_consumption=128' \
    'opcache.max_accelerated_files=10000' \
    > /usr/local/etc/php/conf.d/opcache-production.ini

WORKDIR /var/www/html
COPY --from=vendor /app/vendor ./vendor
COPY . .

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && php artisan route:cache \
    && php artisan view:cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data
EXPOSE 80

CMD ["sh", "docker/vercel-start.sh"]
